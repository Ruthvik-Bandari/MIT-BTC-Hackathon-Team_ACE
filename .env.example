# SatsGuard Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Alby Lightning (Nostr Wallet Connect)
ALBY_NWC_URL=nostr+walletconnect://xxxxx

# Cogcoin (team has access)
COGCOIN_API_KEY=xxxxxxxxxxxxx

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Bitcoin Network
BITCOIN_NETWORK=signet
MEMPOOL_API_URL=https://mempool.space/signet/api

# Deployment (set in Vercel/Railway dashboard, not here)
# VERCEL_URL=satsguard.vercel.app
# RAILWAY_URL=satsguard-api.railway.app
